{
  "manifest_version": 3,
  "name": "Snow",
  "version": "0.1.0",
  "description": "Transcribe current tab audio locally and download a transcript.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "tabCapture", "offscreen", "sidePanel"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Snow",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "ort/*", "worklets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
